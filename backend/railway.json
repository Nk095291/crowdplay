{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "python manage.py collectstatic --noinput && uvicorn config.asgi:application --host 0.0.0.0 --port $PORT",
    "healthcheckPath": "/api/health/",
    "restartPolicyType": "ON_FAILURE"
  }
}
